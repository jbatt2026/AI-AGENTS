#!/bin/bash
# Pre-commit hook to prevent accidental commits of secrets and .env files
# Install: git config --local core.hooksPath .githooks

set -euo pipefail

echo "🔒 Running pre-commit secret scan..."

while IFS= read -r -d '' staged_file; do
  case "$staged_file" in
    .env.example)
      ;;
    .env|.env.*|*/.env|*/.env.*|*.pem|agent.config.json|*/agent.config.json)
      echo "❌ ERROR: Refusing to commit local credential file: $staged_file"
      exit 1
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# Scan the exact staged content, not the possibly different working-tree copy.
python3 .github/scripts/scan_secrets.py --staged .

echo "✅ Pre-commit checks passed!"
exit 0
