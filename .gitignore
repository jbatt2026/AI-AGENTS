# Dependencies
node_modules/
# package-lock.json is committed on purpose: the CI workflow runs `npm ci`,
# which requires a lockfile and fails without one.
yarn.lock

# Build outputs
dist/
build/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables - NEVER commit these!
.env
.env.local
.env.*.local
.env.pem
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# Agent server runtime files (token, audit log)
.agent-token
.agent-log.jsonl

# Session files
.vite/

# Clawness — per-machine session state (memory.md and rules/ stay shared)
.clawness/*
!.clawness/memory.md
!.clawness/rules/
