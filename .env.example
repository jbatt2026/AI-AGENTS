# AI Agents GitHub Automation Studio Environment Variables
# SECURITY WARNING: This file is for reference only. NEVER commit actual credentials.
#
# For local development:
#   1. Copy this file to .env.local (which is .gitignored)
#   2. Add REAL values to .env.local ONLY
#   3. Run: git update-index --skip-worktree .env.local
#
# For GitHub Actions / CI/CD:
#   1. Add secrets via GitHub Settings > Secrets > Actions
#   2. Reference as: ${{ secrets.GITHUB_APP_PRIVATE_KEY }}
#
# For Docker / Cloud deployments:
#   1. Use cloud platform secret management (AWS Secrets Manager, GCP Secret Manager, etc.)
#   2. Inject at runtime, never bake into images

# GitHub App credentials - obtain from https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_WEBHOOK_SECRET=

# Target repository configuration
GITHUB_TARGET_REPO=jbatt2026/AI-AGENTS

# Development server configuration (override default localhost:3000)
# Only set VITE_HOST=0.0.0.0 when on secure/trusted network
# VITE_HOST=127.0.0.1
# VITE_PORT=3000

# Webhook configuration (set when deploying webhook handler)
# GITHUB_WEBHOOK_URL=https://your-deployment.example.com/api/github/webhook
